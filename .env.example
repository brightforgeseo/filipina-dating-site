# Copy to .env for local dev. In Netlify, set these under Site settings → Environment variables.
# These are the Firebase WEB config — they are safe to expose client-side (security is enforced by Firestore rules).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Web push (notifications). Firebase console → Project settings → Cloud Messaging
# → Web Push certificates → "Key pair". Without it, web push is disabled (the
# rest of the site is unaffected).
PUBLIC_FIREBASE_VAPID_KEY=

# 1-on-1 video calling. Same Agora App ID the mobile app uses
# (EXPO_PUBLIC_AGORA_APP_ID). Without it, the call button is hidden.
PUBLIC_AGORA_APP_ID=

# Optional: app store listing URLs. The download buttons on the homepage
# are hidden until these are set.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
