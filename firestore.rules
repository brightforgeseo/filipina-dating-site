rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isMatchParticipant(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return request.auth.uid == m.user1Id || request.auth.uid == m.user2Id;
    }

    // Profiles — any signed-in user can browse; only the owner can write their own doc.
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Swipes — the swiper can read their own; the recipient can read likes
    // aimed at them (powers the "Likes you" page).
    match /swipes/{swipeId} {
      allow read: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
    }

    // Matches — participants can read, update (lastMessage etc.) and delete (unmatch).
    // Creates are allowed when the caller is user1 (set by recordSwipe on the client).
    match /matches/{matchId} {
      allow read, update, delete: if isSignedIn()
        && (resource.data.user1Id == request.auth.uid
            || resource.data.user2Id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.user1Id == request.auth.uid;

      // Messages subcollection — participants only; senders must identify themselves;
      // only the isRead field may be updated (for read-receipts).
      match /messages/{messageId} {
        allow read: if isSignedIn() && isMatchParticipant(matchId);
        allow create: if isSignedIn()
          && isMatchParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn()
          && isMatchParticipant(matchId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isSignedIn() && isMatchParticipant(matchId);
      }
    }

    // Blocks — blockerId can create and delete; either party can read records
    // that involve them (needed to filter blocked users from Discover).
    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    // Reports — write-only from the client (reporter must identify
    // themselves); reviewed by the team in the Firebase console.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Community feed — any member can read; authors own their posts.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Like doc id == the liker's uid, one like per member.
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      // Gifts. While paid gifting is off (config/app.paidGiftsEnabled != true)
      // clients may write free gifts directly; once it's on, only the
      // sendPaidGift Cloud Function (admin SDK) writes gifts.
      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && !(exists(/databases/$(database)/documents/config/app)
               && get(/databases/$(database)/documents/config/app).data.paidGiftsEnabled == true);
      }
    }

    // App-level feature flags — set by the team in the console.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Coin wallets — written only by Cloud Functions (admin SDK).
    match /wallets/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Live streams — host owns the stream doc; viewers manage their own
    // presence; WebRTC signaling docs are ephemeral and open to members.
    match /streams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /connections/{connId}/{document=**} {
        allow read, write: if isSignedIn();
      }

      match /viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == viewerId;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }

      // Same paid/free gating as post gifts.
      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && !(exists(/databases/$(database)/documents/config/app)
               && get(/databases/$(database)/documents/config/app).data.paidGiftsEnabled == true);
      }
    }

    // Follows — doc id is `${followerId}_${followedId}`; the follower owns it.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Community groups — anyone can create; only the owner can edit/delete.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Group memberships — doc id is `${groupId}_${userId}`; members manage
    // their own membership.
    match /groupMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
