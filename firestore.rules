rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(userId1, userId2) {
      return isSignedIn() && (request.auth.uid == userId1 || request.auth.uid == userId2);
    }

    function paidGiftsEnabled() {
      return exists(/databases/$(database)/documents/config/app)
        && get(/databases/$(database)/documents/config/app).data.paidGiftsEnabled == true;
    }

    function isMatchParticipant(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return isParticipant(m.user1Id, m.user2Id);
    }

    // Profiles: signed-in users can browse; only the owner can write their own profile.
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      // Gifts sent directly to a member, same paid/free gating as posts.
      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && userId != request.auth.uid
          && !paidGiftsEnabled();
      }
    }

    // Swipes: the swiper can manage their own; the recipient can read likes aimed at them.
    match /swipes/{swipeId} {
      allow read: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.fromUserId == request.auth.uid;
    }

    // Matches: both participants can read, update and delete. Creates must involve the signed-in user.
    match /matches/{matchId} {
      allow read, update, delete: if isParticipant(resource.data.user1Id, resource.data.user2Id);
      allow create: if isSignedIn()
        && (request.resource.data.user1Id == request.auth.uid
            || request.resource.data.user2Id == request.auth.uid);

      // Messages subcollection: match participants only; senders must identify themselves on create.
      match /messages/{messageId} {
        allow read: if isSignedIn() && isMatchParticipant(matchId);
        allow create: if isSignedIn()
          && isMatchParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn()
          && isMatchParticipant(matchId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isSignedIn() && isMatchParticipant(matchId);
      }
    }

    // Reports: write-only from the client, reviewed by the team in Firebase.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // Blocks: support both web field name (blockedId) and mobile field name (blockedUserId).
    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid
            || resource.data.blockedUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    // Community feed: any member can read; authors own their posts.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && (request.resource.data.groupId == null
            || exists(/databases/$(database)/documents/groupMembers/$(request.resource.data.groupId + '_' + request.auth.uid)));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && !paidGiftsEnabled();
      }
    }

    // App-level feature flags, set by the team in the console.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Coin wallets and commercial ledgers, written only by Cloud Functions/admin SDK.
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Live streams: host owns stream doc; viewers manage their own presence; WebRTC signaling is open to members.
    match /streams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /connections/{connId}/{document=**} {
        allow read, write: if isSignedIn();
      }

      match /viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == viewerId;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }

      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && !paidGiftsEnabled();
      }
    }

    // Follows: doc id is `${followerId}_${followedId}`; the follower owns it.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Community groups: anyone can create; only the owner can edit/delete.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Group memberships: doc id is `${groupId}_${userId}`; members manage their own membership.
    match /groupMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Presence document collection used by the mobile app.
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Push tokens and commercial/account records are user-owned.
    match /pushTokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /boosts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /credits/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Verification requests are user-readable and owner-created. Only server/admin should approve verified=true.
    match /verifications/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']));
      allow delete: if false;
    }

    // Calls: caller or callee can read/update/delete; caller creates.
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
