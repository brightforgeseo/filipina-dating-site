---
import LogoMark from './LogoMark.astro';
import { SUPPORT_EMAIL } from '../lib/constants';
import { t, parsePath, localizePath, LOCALIZED_PATHS, LANGS, type Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const d = t(lang);
const l = (p: string) => localizePath(p, lang);

const { base } = parsePath(Astro.url.pathname);
const switchBase = LOCALIZED_PATHS.includes(base) ? base : '/';
---
<footer class="pt-20 pb-10 border-t border-line">
  <div class="max-w-[1240px] mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 mb-14">
      <div class="md:col-span-2">
        <a href={l('/')} class="flex items-center gap-2.5 font-display text-[22px] font-bold mb-4 text-ink"><LogoMark /> FilWest</a>
        <p class="text-[15px] text-ink-soft max-w-[300px] leading-[1.55]">{d.footer.tagline}</p>
        <div class="mt-5 flex gap-2">
          <span class="chip">{d.footer.freeChip}</span>
        </div>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.1em] text-muted mb-4 font-semibold">{d.footer.product}</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-soft">
          <li><a href={l('/#how')} class="hover:text-coral">{d.nav.how}</a></li>
          <li><a href={l('/safety')} class="hover:text-coral">{d.nav.safety}</a></li>
          <li><a href={l('/pricing')} class="hover:text-coral">{d.nav.pricing}</a></li>
          <li><a href={l('/#app')} class="hover:text-coral">{d.nav.app}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.1em] text-muted mb-4 font-semibold">{d.footer.company}</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-soft">
          <li><a href={l('/safety')} class="hover:text-coral">{d.footer.aboutSafety}</a></li>
          <li><a href="/guides" class="hover:text-coral">{d.footer.guides}</a></li>
          <li><a href={`mailto:${SUPPORT_EMAIL}`} class="hover:text-coral">{d.footer.contact}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.1em] text-muted mb-4 font-semibold">{d.footer.legal}</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-soft">
          <li><a href="/terms" class="hover:text-coral">{d.footer.terms}</a></li>
          <li><a href="/privacy" class="hover:text-coral">{d.footer.privacy}</a></li>
          <li><a href="/community" class="hover:text-coral">{d.footer.community}</a></li>
        </ul>
      </div>
    </div>
    <div class="flex justify-between items-center pt-7 border-t border-line text-xs text-muted flex-wrap gap-3">
      <div>© 2026 FilWest</div>
      <div class="flex gap-3">
        {(Object.entries(LANGS) as [Lang, string][]).map(([code, name]) => (
          code === lang
            ? <span class="font-semibold text-ink">{name}</span>
            : <a href={localizePath(switchBase, code)} class="hover:text-coral">{name}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
