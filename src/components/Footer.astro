---
import LogoMark from './LogoMark.astro';
---
<footer class="pt-20 pb-10 border-t border-line">
  <div class="max-w-[1240px] mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 mb-14">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2.5 font-display text-[22px] font-bold mb-4 text-ink"><LogoMark /> FilWest</a>
        <p class="text-[15px] text-ink-soft max-w-[300px] leading-[1.55]">Dating for Filipinas and the people who love them. Same profiles, same messages, on the web and on the app.</p>
        <div class="mt-5 flex gap-2">
          <span class="chip">Free for Filipinas</span>
        </div>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.1em] text-muted mb-4 font-semibold">Product</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-soft">
          <li><a href="/#how" class="hover:text-coral">How it works</a></li>
          <li><a href="/safety" class="hover:text-coral">Safety</a></li>
          <li><a href="/pricing" class="hover:text-coral">Pricing</a></li>
          <li><a href="/#app" class="hover:text-coral">Get the app</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.1em] text-muted mb-4 font-semibold">Company</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-soft"><li>About</li><li>Contact</li><li>Careers</li></ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.1em] text-muted mb-4 font-semibold">Legal</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-soft"><li>Terms</li><li>Privacy</li><li>Community rules</li></ul>
      </div>
    </div>
    <div class="flex justify-between items-center pt-7 border-t border-line text-xs text-muted">
      <div>© 2026 FilWest</div>
      <div>EN · Tagalog · Cebuano</div>
    </div>
  </div>
</footer>
