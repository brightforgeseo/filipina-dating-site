---
import LogoMark from './LogoMark.astro';
---
<nav class="sticky top-0 z-50 backdrop-blur-xl border-b border-line" style="background: rgba(255,245,247,0.88)">
  <div class="max-w-[1240px] mx-auto px-8 h-[68px] flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 font-display text-[22px] font-bold tracking-[-0.02em] text-ink">
      <LogoMark />
      FilWest
    </a>
    <div class="hidden md:flex gap-7 text-sm text-ink-soft font-medium">
      <a href="/#how" class="hover:text-coral transition">How it works</a>
      <a href="/safety" class="hover:text-coral transition">Safety</a>
      <a href="/#stories" class="hover:text-coral transition">Stories</a>
      <a href="/pricing" class="hover:text-coral transition">Pricing</a>
      <a href="/#app" class="hover:text-coral transition">Get the app</a>
    </div>
    <div class="flex gap-2.5 items-center">
      <a href="/login" class="btn btn-ghost btn-sm">Log in</a>
      <a href="/signup" class="btn btn-primary btn-sm">
        Sign up
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</nav>
