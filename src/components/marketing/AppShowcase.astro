---
// Store buttons appear once the listing URLs are configured (see .env.example).
const appStoreUrl = import.meta.env.PUBLIC_APP_STORE_URL;
const playStoreUrl = import.meta.env.PUBLIC_PLAY_STORE_URL;
---
<section id="app" class="pb-24">
  <div class="max-w-[1240px] mx-auto px-8">
    <div class="rounded-[28px] px-10 md:px-16 py-16 md:py-20 overflow-hidden relative" style="background: linear-gradient(180deg, var(--ivory-2), var(--blush))">
      <div class="grid md:grid-cols-[1fr_1.1fr] gap-12 items-center">
        <div>
          <div class="eyebrow">Download</div>
          <h2 class="heading-1 my-4" style="font-size: clamp(36px, 5vw, 54px)">FilWest goes where you go.</h2>
          <p class="text-[16px] leading-[1.6] text-ink-soft max-w-[440px]">
            The app and the website share the same account. Start a conversation on your laptop, keep it going on your phone. No syncing, no re-login.
          </p>
          <div class="flex flex-col gap-2.5 mt-7 text-sm text-ink-soft">
            <div class="flex gap-2.5 items-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--coral)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6"/></svg>
              Push notifications for new matches and messages
            </div>
            <div class="flex gap-2.5 items-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--coral)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6"/></svg>
              Tap-to-translate in-chat, EN ↔ Tagalog
            </div>
            <div class="flex gap-2.5 items-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--coral)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6"/></svg>
              Video calls with end-to-end encryption
            </div>
          </div>
          <div class="flex gap-3 mt-8 flex-wrap">
            {appStoreUrl && (
              <a href={appStoreUrl} rel="noopener" class="inline-flex items-center gap-2.5 bg-ink text-white rounded-xl px-5 py-3 text-sm font-medium">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 12.3c0-2.3 1.9-3.4 2-3.4-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.6.9-.7 0-1.9-.8-3.2-.8-1.6 0-3.2.9-4 2.4-1.7 3-.4 7.5 1.3 9.9.8 1.2 1.8 2.5 3 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.7-3.5z"/></svg>
                <div class="text-left leading-tight"><div class="text-[10px] opacity-80">Download on the</div><div>App Store</div></div>
              </a>
            )}
            {playStoreUrl && (
              <a href={playStoreUrl} rel="noopener" class="inline-flex items-center gap-2.5 bg-ink text-white rounded-xl px-5 py-3 text-sm font-medium">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M3 2.7v18.6c0 .5.3 1 .7 1.2l10.7-10.5L3.7 1.5c-.4.2-.7.7-.7 1.2z"/></svg>
                <div class="text-left leading-tight"><div class="text-[10px] opacity-80">Get it on</div><div>Google Play</div></div>
              </a>
            )}
            <a href="/signup" class="btn btn-primary">Use on web →</a>
          </div>
        </div>

        <div class="relative h-[520px] flex items-center justify-center">
          <div class="relative w-[280px] h-[500px] rounded-[40px] p-2.5" style="background: #1F1419; box-shadow: 0 30px 80px rgba(255,20,147,0.25)">
            <div class="w-full h-full rounded-[32px] overflow-hidden flex flex-col bg-white">
              <div class="px-4 py-3 border-b border-line flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full flex items-center justify-center font-display font-semibold text-ink" style="background: var(--blush)">M</div>
                <div class="flex-1">
                  <div class="font-display font-semibold text-[15px]">Mariel</div>
                  <div class="text-[10px] flex items-center gap-1 text-ok"><span class="w-1.5 h-1.5 rounded-full bg-ok"></span>Online</div>
                </div>
              </div>
              <div class="flex-1 p-4 flex flex-col gap-2" style="background: var(--ivory)">
                <div class="self-start bg-white border border-line px-3 py-2 rounded-2xl text-[12px] max-w-[80%] rounded-bl-sm">Kumain ka na ba?</div>
                <div class="self-start text-[10px] italic text-muted -mt-1 ml-1">translated: have you eaten yet?</div>
                <div class="self-end text-white px-3 py-2 rounded-2xl text-[12px] max-w-[80%] rounded-br-sm" style="background: var(--coral)">Just had breakfast 🍳</div>
                <div class="self-start bg-white border border-line px-3 py-2 rounded-2xl text-[12px] max-w-[80%] rounded-bl-sm">I'm free this weekend if you want to video call</div>
              </div>
              <div class="p-3 border-t border-line flex gap-2 items-center">
                <div class="flex-1 bg-ivory border border-line rounded-full px-3 py-2 text-[11px] text-muted">Type a message…</div>
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white" style="background: var(--coral)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
