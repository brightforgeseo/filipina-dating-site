---
import { t, type Lang } from '../../i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const d = t(lang);
---
<div class="max-w-[1240px] mx-auto px-8 pb-4">
  <div class="grid grid-cols-2 md:grid-cols-4 bg-white rounded-2xl border border-line overflow-hidden">
    {d.features.map((f, i) => (
      <div class={`p-7 flex flex-col gap-1.5 ${i === 0 || i === 2 ? 'border-r border-line' : ''} ${i === 1 ? 'md:border-r border-line' : ''}`}>
        <div class="font-display font-bold text-[28px] tracking-[-0.02em] text-coral">{f.big}</div>
        <div class="text-[13px] text-ink-soft">{f.small}</div>
      </div>
    ))}
  </div>
</div>
