---
import { t, localizePath, type Lang } from '../../i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const d = t(lang);
const l = (p: string) => localizePath(p, lang);
---
<section class="relative pt-16 pb-24 overflow-hidden">
  <div class="absolute -top-20 -right-20 w-[520px] h-[520px] rounded-full opacity-40" style="background: radial-gradient(closest-side, var(--blush), transparent)"></div>
  <div class="absolute -bottom-40 -left-40 w-[600px] h-[600px] rounded-full opacity-30" style="background: radial-gradient(closest-side, var(--ivory-2), transparent)"></div>

  <div class="max-w-[1240px] mx-auto px-8 grid md:grid-cols-[1.1fr_1fr] gap-16 items-center relative">
    <div>
      <div class="chip chip-coral">
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--coral)"></span>
        {d.hero.chip}
      </div>
      <h1 class="heading-display mt-5" style="font-size: clamp(52px, 6.8vw, 92px)">
        {d.hero.line1}<br/>
        {d.hero.line2}<br/>
        <span class="text-coral">{d.hero.line3}</span>
      </h1>
      <p class="text-[17px] leading-[1.6] text-ink-soft max-w-[480px] mt-6">
        {d.hero.body}
      </p>
      <div class="mt-8 flex gap-3 items-center flex-wrap">
        <a href={l('/signup')} class="btn btn-primary btn-lg">{d.hero.ctaSignup} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        <a href={l('/#how')} class="btn btn-ghost btn-lg">{d.hero.ctaHow}</a>
      </div>
      <div class="mt-8 text-xs text-muted">{d.hero.freeNote}</div>
    </div>

    <div class="relative h-[540px] flex items-center justify-center">
      <div class="relative w-[300px] h-[520px] rounded-[44px] p-3" style="background: #1F1419; box-shadow: 0 30px 80px rgba(255,20,147,0.25)">
        <div class="w-full h-full rounded-[34px] overflow-hidden relative" style="background: linear-gradient(160deg, #FFDEE9, #FFB6C1)">
          <div class="absolute top-3 left-1/2 -translate-x-1/2 w-20 h-5 rounded-full bg-black/80"></div>
          <div class="absolute top-10 left-5 right-5 flex gap-1">
            <div class="flex-1 h-1 rounded bg-white"></div>
            <div class="flex-1 h-1 rounded bg-white/40"></div>
            <div class="flex-1 h-1 rounded bg-white/40"></div>
          </div>
          <div class="absolute top-16 right-5 text-white text-[10px] px-2.5 py-1 rounded-full flex items-center gap-1 font-medium" style="background: var(--coral)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l8 3v7c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V5l8-3z"/></svg> {d.hero.verified}
          </div>
          <div class="absolute bottom-5 left-5 right-5 text-ink">
            <div class="font-display font-bold text-[30px] leading-none">Mariel, 26</div>
            <div class="text-[12px] mt-1.5 flex items-center gap-1 opacity-80">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
              Cebu City
            </div>
            <div class="text-[12px] mt-3 leading-[1.45] px-3 py-2.5 rounded-xl bg-white/75 backdrop-blur-sm">
              {d.hero.phoneBio}
            </div>
            <div class="flex gap-2.5 justify-center mt-4">
              <button class="w-[44px] h-[44px] rounded-full bg-white flex items-center justify-center text-ink-soft shadow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
              </button>
              <button class="w-[54px] h-[54px] rounded-full flex items-center justify-center text-white shadow-lg" style="background: var(--coral)">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.5-9.5-10C1 7 4 4 7.5 4c2 0 3.5 1 4.5 2.5C13 5 14.5 4 16.5 4 20 4 23 7 21.5 11 19.5 16.5 12 21 12 21z"/></svg>
              </button>
              <button class="w-[44px] h-[44px] rounded-full bg-white flex items-center justify-center shadow" style="color: var(--gold)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17.3 5.9 20.5l1.5-6.8L2.2 9l6.9-.7L12 2z"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="absolute top-8 -left-2 bg-white border border-line rounded-2xl px-3.5 py-2.5 shadow flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white" style="background: var(--coral)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.5-9.5-10C1 7 4 4 7.5 4c2 0 3.5 1 4.5 2.5C13 5 14.5 4 16.5 4 20 4 23 7 21.5 11 19.5 16.5 12 21 12 21z"/></svg>
        </div>
        <div>
          <div class="text-xs font-semibold text-ink">{d.hero.matchTitle}</div>
          <div class="text-[10px] text-muted">{d.hero.matchSub}</div>
        </div>
      </div>
      <div class="absolute bottom-10 -right-2 bg-white border border-line rounded-2xl px-3.5 py-2.5 shadow flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background: rgba(76,175,80,0.15); color: var(--ok)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6"/></svg>
        </div>
        <div>
          <div class="text-xs font-semibold text-ink">{d.hero.idVerifiedTitle}</div>
          <div class="text-[10px] text-muted">{d.hero.idVerifiedSub}</div>
        </div>
      </div>
    </div>
  </div>
</section>
