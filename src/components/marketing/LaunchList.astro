---
// Server-side capture confirms persistent storage before displaying success.
---
<section id="launch-list" class="px-5 pb-20 scroll-mt-24" aria-labelledby="launch-title">
  <div class="max-w-[900px] mx-auto rounded-[28px] border border-line bg-white p-6 md:p-12">
    <p class="eyebrow">Coming soon</p>
    <h2 id="launch-title" class="heading-1 mt-3 mb-4" style="font-size: clamp(28px, 4vw, 44px); line-height: 1.15">Be there when FilWest opens.</h2>
    <p class="text-ink-soft leading-relaxed mb-6">We are building a Filipina dating site and app for serious Filipino-Western relationships. Join our launch email list and we will let you know when you can start. No account, payment or identity documents needed.</p>
    <form name="filwest-launch" method="POST" action="/.netlify/functions/launch-list">
      <input type="hidden" name="form-name" value="filwest-launch" />
      <input type="hidden" name="consent-version" value="launch-2026-09-24" />
      <p hidden><label>Leave this blank <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>
      <label for="launch-email" class="block font-semibold mb-2">Email address</label>
      <div class="flex flex-col sm:flex-row gap-3">
        <input id="launch-email" name="email" type="email" autocomplete="email" maxlength="254" required class="min-w-0 flex-1 border border-line rounded-xl px-4 py-3 bg-white text-ink focus:outline-2 focus:outline-coral" placeholder="you@example.com" aria-describedby="launch-privacy" />
        <button type="submit" class="btn btn-primary">Notify me at launch</button>
      </div>
      <label class="flex items-start gap-3 mt-5 text-sm leading-relaxed text-ink-soft">
        <input type="checkbox" name="launch-consent" value="yes" required class="mt-1 shrink-0" />
        <span>I am 18 or over and agree to receive emails about FilWest's launch and access availability.</span>
      </label>
      <p id="launch-privacy" class="mt-4 text-sm text-muted">We will use your email for these updates, not create a dating profile. You can leave the list by emailing <a class="underline" href="mailto:support@filipinawest.com?subject=Remove%20me%20from%20the%20launch%20list">support@filipinawest.com</a>. Read our <a class="underline" href="/privacy#launch-list-privacy">privacy notice</a>. A launch date has not been announced.</p>
      <p data-local-notice hidden class="mt-4 text-sm text-ink-soft" role="status">Preview only: email collection is not connected here. No address has been submitted.</p>
    </form>
  </div>
</section>
<script>
  // Local previews never submit; production success requires server readback.
  const form = document.querySelector<HTMLFormElement>('form[name="filwest-launch"]');
  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const notice = form.querySelector<HTMLElement>('[data-local-notice]')!;
      notice.hidden = false;
      if (['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) return;
      const button = form.querySelector<HTMLButtonElement>('button')!;
      button.disabled = true;
      notice.textContent = 'Saving your request…';
      try {
        const body = new URLSearchParams();
        new FormData(form).forEach((value, key) => body.append(key, String(value)));
        const response = await fetch(form.action, { method: 'POST', body });
        const result = await response.json();
        if (!response.ok || result.stored !== true) throw new Error(result.error || 'We could not confirm your signup. Please try again later.');
        notice.textContent = result.message;
        form.reset();
      } catch (error) {
        notice.textContent = error instanceof Error && !error.message.startsWith('Unexpected') ? error.message : 'We could not confirm your signup. Please try again later.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
