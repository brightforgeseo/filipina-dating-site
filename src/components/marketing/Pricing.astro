---
import { localizePath, type Lang } from '../../i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const copy = {
  en: {
    label: 'Private test preparation', title: 'Get the basics right. Then grow.',
    body: 'We are preparing a free, invitation-only test of FilWest. Profiles, matching, conversations and safety controls come first.',
    steps: ['Invitations are not open yet.', 'Paid subscriptions and gifts are not offered on this page.', 'No payment or identity documents are needed to read about the test.'],
    note: 'Test access will follow deployment checks and a confirmed review process. This is not a public-launch announcement.',
    cta: 'Read our safety guidance',
  },
  tl: {
    label: 'Paghahanda sa pribadong pagsubok', title: 'Ayusin muna ang pundasyon. Saka palawakin.',
    body: 'Naghahanda kami ng libre at imbitasyon-lamang na pagsubok ng FilWest. Uunahin ang profile, matching, usapan at mga kontrol sa kaligtasan.',
    steps: ['Hindi pa bukas ang mga imbitasyon.', 'Walang iniaalok na bayad na subscription o regalo sa pahinang ito.', 'Hindi kailangan ng bayad o dokumento ng pagkakakilanlan para basahin ang tungkol sa pagsubok.'],
    note: 'Magsisimula ang access pagkatapos ng mga pagsusuri sa deployment at pagkumpirma sa proseso ng review. Hindi ito anunsyo ng pampublikong paglulunsad.',
    cta: 'Basahin ang gabay sa kaligtasan',
  },
  ceb: {
    label: 'Pag-andam sa pribadong pagsulay', title: 'Ayuhon una ang pundasyon. Unya palapdon.',
    body: 'Nag-andam kami og libre nga pagsulay sa FilWest para lamang sa mga giimbitar. Unahon ang profile, matching, panag-istorya ug mga kontrol sa kaluwasan.',
    steps: ['Dili pa bukas ang mga imbitasyon.', 'Walay gitanyag nga bayranang subscription o regalo niini nga panid.', 'Dili kinahanglan og bayad o dokumento sa pagkatawo aron mobasa bahin sa pagsulay.'],
    note: 'Mosunod ang access human sa mga pagsusi sa deployment ug pagkumpirma sa proseso sa review. Dili kini pahibalo sa publikong paglunsad.',
    cta: 'Basaha ang giya sa kaluwasan',
  },
}[lang];
---
<section id="pricing" data-private-test class="pb-24">
  <div class="max-w-[1240px] mx-auto px-8">
    <div class="rounded-[28px] bg-white border border-line p-8 md:p-14 max-w-[900px] mx-auto">
      <div class="eyebrow">{copy.label}</div>
      <h2 class="heading-1 my-5" style="font-size: clamp(32px, 5vw, 54px)">{copy.title}</h2>
      <p class="text-[17px] leading-[1.6] text-ink-soft">{copy.body}</p>
      <ul class="my-7 pl-5 space-y-3 text-ink-soft list-disc">{copy.steps.map(step => <li>{step}</li>)}</ul>
      <a href={localizePath('/safety',lang)} class="btn btn-primary">{copy.cta}</a>
      <p class="text-sm text-muted mt-6 leading-relaxed">{copy.note}</p>
    </div>
  </div>
</section>
