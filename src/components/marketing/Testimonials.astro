---
import { t, type Lang } from '../../i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const d = t(lang);
const colors = ['var(--blush)', '#FFE5EC', '#FFD6E0'];
---
<section id="stories" class="pb-24">
  <div class="max-w-[1240px] mx-auto px-8">
    <div class="max-w-[760px] mx-auto text-center mb-14 flex flex-col gap-3.5">
      <div class="eyebrow">{d.stories.eyebrow}</div>
      <h2 class="heading-1" style="font-size: clamp(36px, 5vw, 56px)">{d.stories.title}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {d.stories.items.map((s, i) => (
        <div class="bg-white border border-line rounded-2xl p-7 flex flex-col gap-4">
          <div class="font-display text-[44px] text-coral leading-none -mb-3">“</div>
          <div class="text-[16px] leading-[1.5] text-ink">{s.quote}</div>
          <div class="flex items-center gap-3 mt-auto pt-5 border-t border-line">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-display font-semibold text-ink" style={`background: ${colors[i]}`}>
              {s.name[0]}
            </div>
            <div>
              <div class="text-sm font-semibold">{s.name}</div>
              <div class="text-xs text-muted">{s.meta}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
