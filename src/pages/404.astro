---
import Site from '../layouts/Site.astro';
---
<Site title="Page not found — FilWest" description="That page doesn't exist or was moved.">
  <div class="max-w-[1240px] mx-auto px-8 py-28 text-center">
    <div class="eyebrow">404</div>
    <h1 class="heading-display mt-3 mx-auto" style="font-size: clamp(42px, 6vw, 72px); max-width: 700px">
      Page not found.
    </h1>
    <p class="text-[16px] text-ink-soft mt-5">The page you're looking for doesn't exist or was moved.</p>
    <div class="mt-8">
      <a href="/" class="btn btn-primary">Back home</a>
    </div>
  </div>
</Site>
