---
import Site from '../../layouts/Site.astro';

const guides = [
  {
    "href": "/guides/filipina-dating-sites-serious-relationships",
    "group": "Choosing a Dating Site",
    "title": "Filipina dating sites for serious relationships: how to choose",
    "desc": "FilWest-owned comparison of Filipina dating sites, checked 24 September 2026. Compare audience fit, messaging rules, billing and our private-test status."
  },
  {
    "href": "/guides/free-vs-paid-filipina-dating",
    "group": "Choosing a Dating Site",
    "title": "Free vs paid Filipina dating sites: what Western men should check",
    "desc": "FilWest explains free Filipina dating sites, including signup, replies, paid initiation and cancellation, and what Western men should verify before paying."
  },
  {
    "href": "/guides/religion-and-dating-in-the-philippines",
    "group": "Culture and Expectations",
    "title": "Religion and dating in the Philippines: conversations before commitment",
    "desc": "Ask about worship, children, and ceremonies before you treat a Filipino-Western relationship as committed. Faith labels are not a shared household."
  },
  {
    "href": "/guides/dating-a-filipina-respectfully",
    "group": "Culture and Expectations",
    "title": "Filipino dating culture: a respectful guide for Western men",
    "desc": "How Western men can date a Filipina respectfully: ask her about pace, family, faith and intent. Courtship without stereotypes, scripts or money pressure."
  },
  {
    "href": "/guides/meeting-safely-in-the-philippines",
    "group": "Your First Meeting",
    "title": "Meeting a Filipina in the Philippines: first-visit safety checklist",
    "desc": "Plan a first visit with a public meeting, your own hotel and transport, and a way to leave. Recheck official advice for the exact Philippine route before you book."
  },
  {
    "href": "/guides/meeting-filipina-parents",
    "group": "Culture and Expectations",
    "title": "Meeting your Filipina partner\u2019s parents: practical first-visit advice",
    "desc": "Prepare a family introduction with your partner: who to meet, modest gifts, questions, and boundaries. A visit is context, not marriage consent."
  },
  {
    "href": "/guides/filipinocupid-vs-christian-filipina",
    "group": "Choosing a Dating Site",
    "title": "FilipinoCupid vs Christian Filipina: comparing fit, access and safety",
    "desc": "Compare FilipinoCupid and Christian Filipina on audience fit, messaging, billing and safety. FilWest\u2019s public-source comparison, checked 24 September 2026."
  },
  {
    "href": "/guides/long-distance-relationship-with-a-filipina",
    "group": "Your First Meeting",
    "title": "Long-distance relationships with a Filipina: routines, trust and visit plans",
    "desc": "Build a keepable call schedule, speak exclusivity, set money boundaries, and plan a dated, budgeted visit. Practical guidance for the stretch between calls and meetings."
  },
  {
    "href": "/guides/how-to-message-a-filipina-online",
    "group": "Distance and Communication",
    "title": "How to message a Filipina online respectfully",
    "desc": "Read her profile, send one real question, keep the chat mutual, and stop when she stops. Practical first-message guidance without scripts or pressure."
  },
  {
    "href": "/guides/red-flags-international-dating",
    "group": "Distance and Communication",
    "title": "Filipina dating scams: warning signs and what to do",
    "desc": "Learn which Filipina dating scam warning signs should stop contact, how to save evidence, and when to report to the platform, your bank, and official fraud channels."
  },
  {
    "href": "/guides/first-video-call-tips",
    "group": "Conversations and Safety",
    "title": "First video call with a Filipina: timing, conversation and safety",
    "desc": "Prepare a first video call with a Filipina by naming cities, checking DST dates, agreeing a short ending, and treating quiet or lag as logistics, not proof of intent."
  },
  {
    "href": "/guides/filipina-dating-profile-tips-for-men",
    "group": "Distance and Communication",
    "title": "A dating profile for a serious Filipino-Western relationship",
    "desc": "Prepare an honest dating profile for a Filipino-Western relationship: recent photos, real location, intent, travel, children, and privacy before you publish."
  },
  {
    "href": "/guides/how-to-meet-filipina-women-online",
    "group": "Choosing a Dating Site",
    "title": "How to meet Filipina women online safely",
    "desc": "A respectful path from choosing a platform and writing an honest profile to a video call and a safer first meeting."
  },
  {
    "href": "/guides/first-date-with-a-filipina",
    "group": "Your First Meeting",
    "title": "First date with a Filipina: a respectful plan",
    "desc": "Plan a public, low-pressure first date with clear logistics, mutual conversation, active consent and an easy way for either person to leave."
  },
  {
    "href": "/guides/questions-before-a-filipino-western-relationship-gets-serious",
    "group": "Culture and Expectations",
    "title": "Questions before a Filipino-Western relationship gets serious",
    "desc": "Talk through intent, exclusivity, family, children, faith, work, location, money and visits before making major promises."
  },
  {
    "href": "/guides/money-boundaries-in-international-dating",
    "group": "Conversations and Safety",
    "title": "Money boundaries in international dating",
    "desc": "Separate gifts, travel costs, family support and genuine shared plans from urgency, guilt and financial pressure."
  },
  {
    "href": "/guides/age-gap-filipino-western-relationships",
    "group": "Culture and Expectations",
    "title": "Age-gap Filipino-Western relationships: respect, power and pace",
    "desc": "Consider life stage, financial independence, consent, children, retirement and caregiving without shaming or romanticising the age difference."
  },
  {
    "href": "/guides/english-tagalog-bisaya-relationship-communication",
    "group": "Distance and Communication",
    "title": "English, Tagalog and Bisaya in a Filipino-Western relationship",
    "desc": "Clarify tone, translation, humour and family conversations without treating language or nationality as personality."
  },
  {
    "href": "/guides/long-distance-relationship-exclusivity",
    "group": "Distance and Communication",
    "title": "When is a long-distance relationship exclusive?",
    "desc": "Define exclusivity, dating-profile activity, privacy and boundaries directly instead of guessing from message frequency or pet names."
  },
  {
    "href": "/guides/dating-app-privacy-and-verification",
    "group": "Conversations and Safety",
    "title": "Dating-app ID checks: what happens to your selfie and identity data?",
    "desc": "Before uploading ID or a selfie, check what your dating app retains, who receives it and whether deleting verification data means closing your account."
  },
  {
    "href": "/guides/delete-dating-app-account-and-data",
    "group": "Choosing a Dating Site",
    "title": "Leaving a dating app: account closure, data deletion and billing are different",
    "desc": "Leaving a dating app? Separate account closure, data deletion and subscription cancellation, understand retention, and keep the right confirmations."
  }
];
const groups = [...new Set(guides.map(g => g.group))];
---
<Site
  title="Filipino-Western Dating Guides | FilWest"
  description="Practical guides for Filipino-Western dating: culture, video calls, red flags, and meeting safely in the Philippines."
>
  <div class="max-w-[1240px] mx-auto px-8 pt-16 pb-24">
    <div class="eyebrow">Guides</div>
    <h1 class="heading-display mt-3" style="font-size: clamp(42px, 6vw, 72px)">
      Date smarter,<br/><span class="text-coral">love safer.</span>
    </h1>
    <p class="text-[16px] leading-[1.6] text-ink-soft max-w-[640px] mt-5">
      Honest, practical advice for Filipinas and Western partners building something real across the distance.
    </p>
    <section class="mt-10 p-6 bg-white border border-line rounded-2xl">
      <h2 class="font-display font-semibold text-xl mb-3">Choose Your Next Step</h2>
      <p class="text-sm text-ink-soft leading-relaxed">Deciding whether to join? Read our <a href="/pricing" class="text-coral underline">pricing and access information</a>. If a conversation worries you, start with our <a href="/safety" class="text-coral underline">safety and reporting guidance</a>. For culture, calls and a first visit, choose a guide below.</p>
    </section>
    {groups.map(group => (
    <section class="mt-12">
      <h2 class="font-display font-semibold text-2xl mb-5">{group}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {guides.filter(g => g.group === group).map((g) => (
        <a href={g.href} class="bg-white border border-line rounded-2xl p-7 flex flex-col gap-2 hover:shadow-lg hover:-translate-y-0.5 transition">
          <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] leading-[1.25] m-0">{g.title}</h3>
          <p class="text-sm text-ink-soft leading-[1.55] m-0">{g.desc}</p>
          <span class="text-coral text-sm font-semibold mt-1">Read the guide →</span>
        </a>
      ))}
      </div>
    </section>
    ))}
  </div>
</Site>
