---
import Site from '../layouts/Site.astro';
import Pricing from '../components/marketing/Pricing.astro';
---
<Site title="Pricing — FilWest" description="FilWest pricing: free for women from the Philippines, fair plans for everyone else. No hidden fees, cancel anytime.">
  <div class="max-w-[1240px] mx-auto px-8 pt-16 pb-6 text-center">
    <div class="eyebrow">Pricing</div>
    <h1 class="heading-display mt-3 mx-auto" style="font-size: clamp(42px, 6vw, 72px); max-width: 800px">
      Fair pricing.<br/><span class="text-coral">Honest intent.</span>
    </h1>
  </div>
  <Pricing />
</Site>
