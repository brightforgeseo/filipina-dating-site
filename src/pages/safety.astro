---
import Site from '../layouts/Site.astro';
import Safety from '../components/marketing/Safety.astro';
---
<Site title="Safety — FilWest" description="How FilWest keeps long-distance dating safe: identity verification, video calls before meeting, and a team that reviews every report.">
  <div class="max-w-[1240px] mx-auto px-8 pt-16 pb-6">
    <div class="eyebrow">Safety center</div>
    <h1 class="heading-display mt-3" style="font-size: clamp(42px, 6vw, 72px)">
      Safety first,<br/><span class="text-coral">every step.</span>
    </h1>
    <p class="text-[16px] leading-[1.6] text-ink-soft max-w-[640px] mt-5">
      Long-distance dating only works if everyone feels safe. Nobody gets in without verifying who they are, and nobody meets in person before a real video call.
    </p>
  </div>
  <Safety />
</Site>
